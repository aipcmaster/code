<UserControl x:Class="AIPCMaster.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diag="clr-namespace:AIPCMaster.Core.Diagnosis;assembly=AIPCMaster.Core">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- 标题 -->
            <TextBlock Text="仪表盘" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20" />

            <!-- 健康分卡片 -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 健康环（简化：圆环文本） -->
                    <Border Width="120" Height="120" CornerRadius="60"
                            Background="{StaticResource CardBgBrush}" BorderThickness="8"
                            BorderBrush="{Binding HealthScore, Converter={StaticResource ScoreColorConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HealthScore}" FontSize="40" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="健康分" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0">
                        <TextBlock Text="智能诊断结论" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RootCauseSummary}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding LoggedInStatus}" Margin="0,14,0,0" />
                        <TextBlock Text="{Binding ServerStatus}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="一键诊断" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunDiagnosisCommand}" />
                </Grid>
            </Border>

            <!-- 问题列表 -->
            <TextBlock Text="检测到的问题" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10" />
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrushConverter}}"
                                        CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityDisplayConverter}}"
                                               Foreground="White" FontSize="12" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Category, Converter={StaticResource CategoryDisplayConverter}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="暂无问题，系统状态良好 ✨" Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding Issues.Count, Converter={StaticResource EmptyCountConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>