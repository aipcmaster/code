<UserControl x:Class="AIPCMaster.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20" />

            <!-- 账号 -->
            <TextBlock Text="账号" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding LoggedInStatus}" Margin="0,0,0,12" FontWeight="SemiBold" />
                    <TextBlock Text="邮箱" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8,6" />
                    <TextBlock Text="密码" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,4,0,16" Padding="8,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="登录" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Click="Login_Click" />
                        <Button Content="注册" Style="{StaticResource PrimaryButton}" Background="#00BFA6" Click="Register_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 服务器 -->
            <TextBlock Text="云端服务" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding ServerStatus}" Margin="0,0,0,8" Foreground="{StaticResource BrandTealBrush}" />
                    <TextBlock Text="API 地址" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8,6" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" />
                </StackPanel>
            </Border>

            <!-- 设备 -->
            <TextBlock Text="本机设备" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="设备唯一标识" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding DeviceId}" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12" />
                    <TextBlock Text="首次启动自动生成，用于设备绑定与诊断上报（PRD §4.4）"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="AIPCMaster（AI电脑大师）v1.0.0" FontWeight="SemiBold" />
                    <TextBlock Text="AI 驱动的电脑优化与维护助手 · 端侧智能诊断，默认只读，执行前确认"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>