<Window x:Class="AIPCMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIPCMaster（AI电脑大师）" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="940">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Background="{StaticResource BgDeepBrush}">
            <StackPanel Margin="16">
                <StackPanel Margin="4,20,4,36">
                    <TextBlock Text="AIPCMaster" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrandTealBrush}" />
                    <TextBlock Text="AI 电脑大师" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>

                <Button Content="📊  仪表盘" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left"
                        Background="Transparent" Click="Nav_Dashboard_Click" Margin="0,0,0,8" />
                <Button Content="🔍  智能诊断" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left"
                        Background="Transparent" Click="Nav_Diagnosis_Click" Margin="0,0,0,8" />
                <Button Content="⚡  优化中心" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left"
                        Background="Transparent" Click="Nav_Optimization_Click" Margin="0,0,0,8" />
                <Button Content="⚙  设置" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left"
                        Background="Transparent" Click="Nav_Settings_Click" Margin="0,0,0,8" />

                <StackPanel VerticalAlignment="Bottom" Margin="4,0,4,12">
                    <TextBlock Text="{Binding HealthScore, StringFormat=健康分：{0}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ServerStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" />
    </Grid>
</Window>