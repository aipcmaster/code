<Application x:Class="AIPCMaster.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIPCMaster.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 转换器 -->
        <conv:ScoreColorConverter x:Key="ScoreColorConverter" />
        <conv:SeverityBrushConverter x:Key="SeverityBrushConverter" />
        <conv:SeverityDisplayConverter x:Key="SeverityDisplayConverter" />
        <conv:CategoryDisplayConverter x:Key="CategoryDisplayConverter" />
        <conv:EmptyCountConverter x:Key="EmptyCountConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:HasTextConverter x:Key="HasTextConverter" />
        <conv:RiskBrushConverter x:Key="RiskBrushConverter" />
        <conv:RiskDisplayConverter x:Key="RiskDisplayConverter" />
        <conv:ActionDisplayConverter x:Key="ActionDisplayConverter" />
        <conv:ConfirmHintConverter x:Key="ConfirmHintConverter" />

        <!-- 品牌色（对齐官网 aipcmaster.com 深蓝+青绿） -->
        <Color x:Key="BrandBlue">#0B3D91</Color>
        <Color x:Key="BrandTeal">#00BFA6</Color>
        <Color x:Key="BgDeep">#0F1B2D</Color>
        <Color x:Key="CardBg">#16263C</Color>
        <Color x:Key="TextPrimary">#E8EEF7</Color>
        <Color x:Key="TextSecondary">#9FB0C6</Color>

        <SolidColorBrush x:Key="BrandBlueBrush" Color="{StaticResource BrandBlue}" />
        <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTeal}" />
        <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeep}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />

        <!-- 健康分级色 -->
        <SolidColorBrush x:Key="ScoreGood" Color="#2ECC71" />
        <SolidColorBrush x:Key="ScoreWarn" Color="#F1C40F" />
        <SolidColorBrush x:Key="ScoreBad" Color="#E74C3C" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BgDeepBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>